! eyes (light) — sage-green theme for X11 apps (xterm, urxvt, etc.)
*background:       #f7dbb9
*foreground:       #231d18

! black
*color0:           #231d18
*color8:           #473b2d

! red
*color1:           #630005
*color9:           #630005

! green
*color2:           #294f01
*color10:          #383f17

! yellow
*color3:           #574a00
*color11:          #5f3700

! blue
*color4:           #073c6e
*color12:          #00314e

! magenta
*color5:           #661b53
*color13:          #3f206c

! cyan
*color6:           #004d44
*color14:          #003e4c

! white
*color7:           #dab992
*color15:          #f2d5b2
