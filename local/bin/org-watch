#!/bin/bash

org="$HOME/Documents/Org"

{
	inotifywait -mqr -e close_write -e create -e delete -e move --exclude '/\.st|\.syncthing\.' --format local "$org" &
	rclone test changenotify Drive:/Org --poll-interval 2s 2>&1 |
		awk '/": [0-9]+$/ { print "remote"; fflush(); next } { print > "/dev/stderr" }' &
	# If either watcher dies, exit so systemd restarts both
	wait -n
	kill 0
} | while read -r source; do
	local_change=0
	# Editors save by rename + rewrite; wait for 1 s of quiet so bisync never sees the file half-saved
	while :; do
		[[ $source == local ]] && local_change=1
		read -r -t 1 source || break
	done
	systemctl --user start org-bisync.service
	((local_change)) && systemctl --user start --no-block org-mirror.service
done
