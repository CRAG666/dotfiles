#!/usr/bin/env python3
import argparse
import fcntl
import json
import logging
import os
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib
from abc import ABC, abstractmethod
from collections import Counter, defaultdict
from collections.abc import Callable, Iterator, Mapping
from concurrent.futures import ThreadPoolExecutor, as_completed
from contextlib import contextmanager, suppress
from dataclasses import dataclass, field, replace
from datetime import UTC, datetime
from enum import StrEnum, auto
from functools import partial
from itertools import chain
from pathlib import Path
from signal import Signals
from typing import ClassVar

type Toml = str | int | float | bool | list[Toml] | dict[str, Toml]
type Table = Mapping[str, Toml]

ROOT = Path(__file__).resolve().parents[2]
HOME = Path.home()
MANIFEST = ROOT / "local/share/eyes-theme/manifest.toml"
STATE_DIR = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "eyes"
COMMANDS = ("light", "dark", "toggle", "auto", "reapply", "status", "generate", "doctor")

log = logging.getLogger("eyes-theme")


class Mode(StrEnum):
    LIGHT = auto()
    DARK = auto()

    @property
    def opposite(self) -> Mode:
        return Mode.LIGHT if self is Mode.DARK else Mode.DARK

    @classmethod
    def for_hour(cls, hour: int) -> Mode:
        return cls.LIGHT if 6 <= hour < 19 else cls.DARK


@dataclass(frozen=True, slots=True)
class Pair[T]:
    light: T
    dark: T

    def __getitem__(self, mode: Mode) -> T:
        return self.dark if mode is Mode.DARK else self.light


class Level(StrEnum):
    OK = "ok"
    WARN = "warn"
    FAIL = "FAIL"


@dataclass(frozen=True, slots=True)
class Finding:
    level: Level
    message: str

    @classmethod
    def verdict(cls, passed: bool, ok: str, fail: str) -> Finding:
        return cls(Level.OK, ok) if passed else cls(Level.FAIL, fail)


def located(spec: str) -> Path:
    return Path(spec).expanduser() if spec.startswith("~") else ROOT / spec


def shown(path: Path) -> str:
    if path.is_relative_to(ROOT):
        return str(path.relative_to(ROOT))
    if path.is_relative_to(HOME):
        return f"~/{path.relative_to(HOME)}"
    return str(path)


def live(path: Path) -> Path:
    relative = path.relative_to(ROOT)
    if relative.parts[0] == "config":
        return HOME / ".config" / relative.relative_to("config")
    return HOME / relative


def has_text(path: Path, text: str) -> bool:
    return path.is_file() and path.read_text(encoding="utf-8") == text


def write_atomic(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            stream.write(text)
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def link_atomic(path: Path, target: str | Path) -> None:
    temporary = path.with_name(f".{path.name}.eyes-tmp")
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(target)
    os.replace(temporary, path)


def running_processes() -> dict[str, tuple[int, ...]]:
    table: defaultdict[str, list[int]] = defaultdict(list)
    for comm in Path("/proc").glob("[0-9]*/comm"):
        with suppress(FileNotFoundError, ProcessLookupError):
            table[comm.read_text(encoding="utf-8").rstrip("\n")].append(int(comm.parent.name))
    return {name: tuple(pids) for name, pids in table.items()}


def systemctl(verb: str, unit: str) -> str:
    return subprocess.run(
        ["systemctl", "--user", verb, unit], capture_output=True, text=True, check=False
    ).stdout.strip()


def unit_findings(unit: str) -> Iterator[Finding]:
    enabled = systemctl("is-enabled", unit)
    yield Finding.verdict(
        enabled == "enabled", f"{unit} enabled", f"{unit} — '{enabled}' (restaurar: just systemd-user)"
    )
    if unit.endswith(".timer") and (active := systemctl("is-active", unit)) != "active":
        yield Finding(Level.WARN, f"{unit} inactivo ('{active}')")


class HexStyle(StrEnum):
    HASH = auto()
    BARE = auto()
    HEXA = auto()


def sgr(hex_color: str) -> str:
    return ";".join(map(str, bytes.fromhex(hex_color)))


@dataclass(frozen=True, slots=True)
class Palette:
    to_dark: Mapping[str, str]

    @classmethod
    def from_table(cls, table: Table) -> Palette:
        return cls({light.lower(): dark.lower() for light, dark in table.values()})

    def translate(self, text: str, style: HexStyle) -> str:
        lights = "|".join(self.to_dark)
        match style:
            case HexStyle.HASH:
                text = re.sub(
                    f"#({lights})", lambda found: f"#{self.to_dark[found[1].lower()]}", text, flags=re.IGNORECASE
                )
                triplets = {sgr(light): sgr(dark) for light, dark in self.to_dark.items()}
                alternatives = "|".join(map(re.escape, triplets))
                return re.sub(
                    rf"([34]8;2;)({alternatives})(?!\d)", lambda found: found[1] + triplets[found[2]], text
                )
            case HexStyle.BARE:
                return re.sub(
                    rf"\b({lights})\b", lambda found: self.to_dark[found[1].lower()], text, flags=re.IGNORECASE
                )
            case HexStyle.HEXA:
                return re.sub(
                    rf"\b({lights})((?:[0-9a-f]{{2}})?)\b",
                    lambda found: self.to_dark[found[1].lower()] + found[2],
                    text,
                    flags=re.IGNORECASE,
                )


@dataclass(frozen=True, slots=True)
class Generation:
    variants: Pair[Path]
    style: HexStyle
    files: tuple[str, ...] = ()
    replacements: tuple[tuple[str, str], ...] = ()
    after: tuple[str, ...] = ()

    @classmethod
    def from_table(cls, spec: Table, variants: Pair[Path]) -> Generation | None:
        match spec.get("generate"):
            case None:
                return None
            case str(style):
                return cls(
                    variants,
                    HexStyle(style),
                    tuple(spec.get("generate_files", ())),
                    tuple(map(tuple, spec.get("generate_replace", ()))),
                    tuple(spec.get("generate_after", ())),
                )
            case invalid:
                raise ValueError(f"generate inválido: {invalid!r}")

    def outputs(self, palette: Palette) -> Iterator[tuple[Path, str]]:
        light, dark = self.variants.light, self.variants.dark
        sources = [(light / name, dark / name) for name in self.files] if self.files else [(light, dark)]
        for source, output in sources:
            text = palette.translate(source.read_text(encoding="utf-8"), self.style)
            for old, new in self.replacements:
                text = text.replace(old, new)
            yield output, text

    def run(self, palette: Palette) -> None:
        if self.files:
            with suppress(FileNotFoundError):
                shutil.rmtree(self.variants.dark)
            self.variants.light.copy(self.variants.dark, follow_symlinks=False, preserve_metadata=True)
        for output, text in self.outputs(palette):
            output.write_text(text, encoding="utf-8")
        if self.after:
            subprocess.run(self.after, check=True)

    def check(self, palette: Palette) -> Iterator[Finding]:
        if not self.variants.light.exists():
            yield Finding(Level.FAIL, f"{shown(self.variants.light)} — falta la variante clara")
            return
        for output, text in self.outputs(palette):
            yield Finding.verdict(
                has_text(output, text),
                shown(output),
                f"{shown(output)} — difiere de lo generado (corre: eyes-theme generate)",
            )


class Target(ABC):
    __slots__ = ()
    section: ClassVar[str]

    @property
    def generation(self) -> Generation | None:
        return None

    def is_present(self) -> bool:
        return True

    @abstractmethod
    def plan(self, mode: Mode) -> str: ...

    @abstractmethod
    def apply(self, mode: Mode) -> None: ...

    @abstractmethod
    def check(self, mode: Mode) -> Iterator[Finding]: ...


@dataclass(frozen=True, slots=True)
class Switch(Target):
    section: ClassVar[str] = "enlaces"
    pointer: Path
    variants: Pair[str]
    generation: Generation | None = None

    @classmethod
    def from_table(cls, spec: Table) -> Switch:
        match spec:
            case {"pointer": str(pointer), "light": str(light), "dark": str(dark)}:
                path = located(pointer)
                files = Pair((path.parent / light).resolve(), (path.parent / dark).resolve())
                return cls(path, Pair(light, dark), Generation.from_table(spec, files))
            case _:
                raise ValueError(f"switch inválido: {spec}")

    def is_present(self) -> bool:
        return not self.pointer.parent.is_dir() or self.pointer.is_symlink()

    def plan(self, mode: Mode) -> str:
        return f"link {shown(self.pointer)} -> {self.variants[mode]}"

    def apply(self, mode: Mode) -> None:
        if not self.pointer.parent.is_dir():
            return
        if self.pointer.is_dir() and not self.pointer.is_symlink():
            shutil.rmtree(self.pointer)
        link_atomic(self.pointer, self.variants[mode])

    def check(self, mode: Mode) -> Iterator[Finding]:
        want = self.variants[mode]
        problems = []
        if not self.pointer.is_symlink():
            problems.append("no es symlink")
        elif (current := str(self.pointer.readlink())) != want:
            problems.append(f"apunta a '{current}', esperaba '{want}'")
        if not (self.pointer.parent / want).exists():
            problems.append(f"falta {want}")
        path = live(self.pointer)
        if not path.exists(follow_symlinks=False):
            problems.append(f"no existe {shown(path)}")
        elif path.resolve() != self.pointer.resolve():
            problems.append(f"{shown(path)} no resuelve igual que el repo")
        yield Finding.verdict(
            not problems, f"{shown(self.pointer)} -> {want}", f"{shown(self.pointer)} — {'; '.join(problems)}"
        )


@dataclass(frozen=True, slots=True)
class Compose(Target):
    section: ClassVar[str] = "compuestos"
    target: Path
    base: Path
    variants: Pair[Path]
    variant_first: bool = False
    generation: Generation | None = None

    @classmethod
    def from_table(cls, spec: Table) -> Compose:
        match spec:
            case {"target": str(target), "base": str(base), "light": str(light), "dark": str(dark)}:
                variants = Pair(located(light), located(dark))
                return cls(
                    located(target),
                    located(base),
                    variants,
                    bool(spec.get("variant_first", False)),
                    Generation.from_table(spec, variants),
                )
            case _:
                raise ValueError(f"compose inválido: {spec}")

    def parts(self, mode: Mode) -> tuple[Path, Path]:
        return (self.variants[mode], self.base) if self.variant_first else (self.base, self.variants[mode])

    def expected(self, mode: Mode) -> str:
        return "".join(part.read_text(encoding="utf-8") for part in self.parts(mode))

    def plan(self, mode: Mode) -> str:
        return f"compose {shown(self.target)}"

    def apply(self, mode: Mode) -> None:
        write_atomic(self.target, self.expected(mode))

    def check(self, mode: Mode) -> Iterator[Finding]:
        label = " + ".join(part.name for part in self.parts(mode))
        yield Finding.verdict(
            has_text(self.target, self.expected(mode)),
            f"{shown(self.target)} ({label})",
            f"{shown(self.target)} — difiere de {label} (corre: eyes-theme reapply)",
        )


@dataclass(frozen=True, slots=True)
class Copy(Target):
    section: ClassVar[str] = "copias"
    target: Path
    variants: Pair[Path]
    rename: tuple[str, str] | None = None

    @classmethod
    def from_table(cls, spec: Table) -> Copy:
        match spec:
            case {"target": str(target), "light": str(light), "dark": str(dark)}:
                rename = tuple(spec["replace"]) if "replace" in spec else None
                return cls(located(target), Pair(located(light), located(dark)), rename)
            case _:
                raise ValueError(f"copy inválido: {spec}")

    def expected(self, mode: Mode) -> str:
        text = self.variants[mode].read_text(encoding="utf-8")
        return re.sub(*self.rename, text) if self.rename else text

    def plan(self, mode: Mode) -> str:
        return f"write {shown(self.target)} from {self.variants[mode].name}"

    def apply(self, mode: Mode) -> None:
        write_atomic(self.target, self.expected(mode))

    def check(self, mode: Mode) -> Iterator[Finding]:
        variant = self.variants[mode].name
        yield Finding.verdict(
            has_text(self.target, self.expected(mode)),
            f"{shown(self.target)} == {variant} (hot-reload vivo)",
            f"{shown(self.target)} no coincide con {variant} (corre: eyes-theme reapply)",
        )


@dataclass(frozen=True, slots=True)
class Link(Target):
    section: ClassVar[str] = "instalaciones"
    path: Path
    target: Path

    @classmethod
    def from_table(cls, spec: Table) -> Link:
        match spec:
            case {"path": str(path), "target": str(target)}:
                return cls(located(path), located(target))
            case _:
                raise ValueError(f"link inválido: {spec}")

    def plan(self, mode: Mode) -> str:
        return f"link {shown(self.path)} -> {shown(self.target)}"

    def apply(self, mode: Mode) -> None:
        if not self.path.exists():
            self.path.parent.mkdir(parents=True, exist_ok=True)
            link_atomic(self.path, self.target)

    def check(self, mode: Mode) -> Iterator[Finding]:
        yield Finding.verdict(
            self.path.exists(), shown(self.path), f"falta {shown(self.path)} (corre: eyes-theme reapply)"
        )


@dataclass(frozen=True, slots=True)
class JsonSetting(Target):
    section: ClassVar[str] = "ajustes"
    file: Path
    key: str
    value: str
    defaults: Mapping[str, str] = field(default_factory=dict)

    @classmethod
    def from_table(cls, spec: Table) -> JsonSetting:
        match spec:
            case {"file": str(file), "key": str(key), "value": str(value)}:
                return cls(located(file), key, value, dict(spec.get("defaults", {})))
            case _:
                raise ValueError(f"json inválido: {spec}")

    def load(self) -> dict[str, Toml]:
        return json.loads(self.file.read_text(encoding="utf-8"))

    def plan(self, mode: Mode) -> str:
        return f"set {self.key}={self.value} in {shown(self.file)}"

    def apply(self, mode: Mode) -> None:
        try:
            settings = self.load()
        except FileNotFoundError:
            settings = dict(self.defaults)
        except json.JSONDecodeError as error:
            log.error("%s no es JSON válido; no se cambia %s: %s", shown(self.file), self.key, error)
            return
        if settings.get(self.key) != self.value:
            text = json.dumps(settings | {self.key: self.value}, indent=2, ensure_ascii=False)
            write_atomic(self.file.resolve(), f"{text}\n")

    def check(self, mode: Mode) -> Iterator[Finding]:
        try:
            current = self.load().get(self.key)
        except FileNotFoundError:
            yield Finding(Level.WARN, f"no existe {shown(self.file)}")
            return
        except json.JSONDecodeError as error:
            yield Finding(Level.FAIL, f"{shown(self.file)} no es JSON válido: {error}")
            return
        yield Finding.verdict(
            current == self.value,
            f"{shown(self.file)}: {self.key}={self.value}",
            f"{shown(self.file)} — {self.key}={current!r}, debería ser '{self.value}' (corre: eyes-theme reapply)",
        )


@dataclass(frozen=True, slots=True)
class IniSetting(Target):
    section: ClassVar[str] = "ajustes"
    file: Path
    key: str
    values: Pair[str]

    @classmethod
    def from_table(cls, spec: Table) -> IniSetting:
        match spec:
            case {"file": str(file), "key": str(key), "light": str(light), "dark": str(dark)}:
                return cls(located(file), key, Pair(light, dark))
            case _:
                raise ValueError(f"ini inválido: {spec}")

    def line(self, mode: Mode) -> str:
        return f"{self.key}={self.values[mode]}"

    def plan(self, mode: Mode) -> str:
        return f"set {self.line(mode)} in {shown(self.file)}"

    def apply(self, mode: Mode) -> None:
        real = self.file.resolve()
        if not real.is_file():
            return
        text = real.read_text(encoding="utf-8")
        updated = re.sub(rf"^{re.escape(self.key)}=.*$", self.line(mode), text, flags=re.MULTILINE)
        if updated != text:
            write_atomic(real, updated)

    def check(self, mode: Mode) -> Iterator[Finding]:
        if not self.file.is_file():
            return
        text = self.file.read_text(encoding="utf-8")
        yield Finding.verdict(
            re.search(rf"^{re.escape(self.line(mode))}$", text, flags=re.MULTILINE) is not None,
            f"{shown(self.file)}: {self.line(mode)}",
            f"{shown(self.file)} — falta {self.line(mode)} (corre: eyes-theme reapply)",
        )


@dataclass(frozen=True, slots=True)
class Wiring:
    label: str
    path: Path
    pattern: str

    @classmethod
    def from_table(cls, label: str, spec: Table) -> Wiring:
        match spec:
            case {"file": str(file), "pattern": str(pattern)}:
                return cls(label, located(file), pattern)
            case _:
                raise ValueError(f"wired inválido en {label}: {spec}")

    def check(self) -> Finding:
        if not self.path.exists():
            return Finding(Level.WARN, f"{self.label} — no existe {shown(self.path)} (¿herramienta no instalada?)")
        candidates = (
            (candidate for candidate in self.path.rglob("*") if candidate.is_file())
            if self.path.is_dir()
            else (self.path,)
        )
        found = any(
            re.search(self.pattern, candidate.read_text(encoding="utf-8", errors="ignore"))
            for candidate in candidates
        )
        return Finding.verdict(
            found,
            f"{self.label}: {shown(self.path)}",
            f"{self.label} — '{self.pattern}' no aparece en {shown(self.path)}",
        )


@dataclass(frozen=True, slots=True)
class Job:
    name: str
    action: Callable[[], object]


@dataclass(frozen=True, slots=True)
class ReloadContext:
    mode: Mode
    processes: Mapping[str, tuple[int, ...]]

    def placeholders(self, pid: int | None) -> dict[str, object]:
        uid = os.getuid()
        return {
            "mode": self.mode,
            "pid": pid,
            "uid": uid,
            "home": HOME,
            "runtime_dir": os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{uid}"),
        }


class Reload(ABC):
    __slots__ = ()

    @classmethod
    def from_table(cls, spec: Table) -> Reload:
        match spec:
            case {"process": str(process), "signal": str(name)}:
                return SignalReload(process, Signals[name])
            case {"run": [*run]}:
                return CommandReload(
                    run=tuple(run),
                    process=spec.get("process"),
                    binary=spec.get("binary"),
                    env_required=spec.get("env_required"),
                    env=dict(spec.get("env", {})),
                )
            case _:
                raise ValueError(f"reload inválido: {spec}")

    @abstractmethod
    def jobs(self, context: ReloadContext) -> Iterator[Job]: ...

    def check(self, context: ReloadContext) -> Iterator[Finding]:
        yield from ()


@dataclass(frozen=True, slots=True)
class SignalReload(Reload):
    process: str
    signum: Signals

    def jobs(self, context: ReloadContext) -> Iterator[Job]:
        for pid in context.processes.get(self.process, ()):
            yield Job(f"{self.signum.name} {self.process}[{pid}]", partial(os.kill, pid, self.signum))


@dataclass(frozen=True, slots=True, kw_only=True)
class CommandReload(Reload):
    run: tuple[str, ...]
    process: str | None = None
    binary: str | None = None
    env_required: str | None = None
    env: Mapping[str, str] = field(default_factory=dict)

    @property
    def program(self) -> str:
        return self.binary or self.run[0]

    def applies(self, context: ReloadContext) -> bool:
        return (self.env_required is None or self.env_required in os.environ) and (
            self.process is None or self.process in context.processes
        )

    def jobs(self, context: ReloadContext) -> Iterator[Job]:
        if not self.applies(context) or shutil.which(self.program) is None:
            return
        per_process = any("{pid}" in part for part in chain(self.run, self.env.values()))
        for pid in context.processes[self.process] if per_process else (None,):
            values = context.placeholders(pid)
            argv = [part.format_map(values) for part in self.run]
            env = os.environ | {
                name: template.format_map(values) for name, template in self.env.items() if name not in os.environ
            }
            yield Job(
                " ".join(argv),
                partial(
                    subprocess.run,
                    argv,
                    env=env,
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    check=True,
                    timeout=30,
                ),
            )

    def check(self, context: ReloadContext) -> Iterator[Finding]:
        if self.applies(context) and shutil.which(self.program) is None:
            yield Finding(
                Level.WARN, f"{self.program} no está instalado: la recarga de {self.process or self.program} no hace nada"
            )


TARGET_KINDS: Mapping[str, Callable[[Table], Target]] = {
    "switch": Switch.from_table,
    "compose": Compose.from_table,
    "copy": Copy.from_table,
    "link": Link.from_table,
    "json": JsonSetting.from_table,
    "ini": IniSetting.from_table,
}
APP_KEYS = TARGET_KINDS.keys() | {"wired", "reload"}


@dataclass(frozen=True, slots=True)
class Manifest:
    palette: Palette
    targets: tuple[Target, ...]
    wirings: tuple[Wiring, ...]
    reloads: tuple[Reload, ...]
    units: tuple[str, ...]

    @classmethod
    def load(cls, path: Path) -> Manifest:
        with path.open("rb") as stream:
            table = tomllib.load(stream)
        targets: list[Target] = []
        wirings: list[Wiring] = []
        reloads: list[Reload] = []
        for name, app in table["apps"].items():
            if unknown := app.keys() - APP_KEYS:
                raise ValueError(f"{shown(path)}: claves desconocidas en apps.{name}: {sorted(unknown)}")
            targets += chain.from_iterable(map(build, app.get(kind, ())) for kind, build in TARGET_KINDS.items())
            wirings += (Wiring.from_table(name, spec) for spec in app.get("wired", ()))
            reloads += map(Reload.from_table, app.get("reload", ()))
        return cls(
            Palette.from_table(table["palette"]),
            tuple(targets),
            tuple(wirings),
            tuple(reloads),
            tuple(table["systemd"]["units"]),
        )

    @property
    def generations(self) -> tuple[Generation, ...]:
        return tuple(target.generation for target in self.targets if target.generation is not None)


@dataclass(frozen=True, slots=True)
class ModeStore:
    directory: Path

    @property
    def file(self) -> Path:
        return self.directory / "mode"

    def read(self) -> Mode:
        try:
            saved = self.file.read_text(encoding="utf-8").strip()
        except FileNotFoundError:
            return Mode.LIGHT
        return Mode.DARK if saved == Mode.DARK else Mode.LIGHT

    def write(self, mode: Mode) -> None:
        write_atomic(self.file, f"{mode}\n")

    @contextmanager
    def locked(self) -> Iterator[None]:
        self.directory.mkdir(parents=True, exist_ok=True)
        with (self.directory / ".lock").open("w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            yield


@dataclass(frozen=True, slots=True)
class Switcher:
    manifest: Manifest
    store: ModeStore
    dry_run: bool = False
    force: bool = False

    def switch(self, mode: Mode) -> None:
        if self.dry_run:
            for target in self.manifest.targets:
                print(f"  would {target.plan(mode)}")
            print("  would reload running daemons\n(dry-run: no se aplicó nada)")
            return
        with self.store.locked():
            if self.is_current(mode):
                print(f"Already in {mode} mode. (use --force / reapply to re-apply anyway)")
                return
            print(f"Switching to {mode}...")
            self.apply(mode)
            self.store.write(mode)
        self.reload(mode)
        print(f"Switched to {mode} mode.")

    def is_current(self, mode: Mode) -> bool:
        return (
            not self.force
            and self.store.file.exists()
            and self.store.read() is mode
            and all(target.is_present() for target in self.manifest.targets)
        )

    def apply(self, mode: Mode) -> None:
        for target in self.manifest.targets:
            target.apply(mode)

    def reload(self, mode: Mode) -> None:
        context = ReloadContext(mode, running_processes())
        jobs = list(chain.from_iterable(reload.jobs(context) for reload in self.manifest.reloads))
        if not jobs:
            return
        with ThreadPoolExecutor(max_workers=len(jobs)) as pool:
            futures = {pool.submit(job.action): job for job in jobs}
            for future in as_completed(futures):
                try:
                    future.result()
                except (OSError, subprocess.SubprocessError) as error:
                    log.warning("falló la recarga «%s»: %s", futures[future].name, error)

    def generate(self) -> None:
        print("Generating dark variants from light canonicals...")
        if self.dry_run:
            for generation in self.manifest.generations:
                print(f"  would generate {shown(generation.variants.dark)} [{generation.style}]")
            return
        for generation in self.manifest.generations:
            generation.run(self.manifest.palette)
            print(f"  generated {shown(generation.variants.dark)}")
        with self.store.locked():
            self.apply(self.store.read())
        print("Done. Review with: git diff --stat")


@dataclass(frozen=True, slots=True)
class Doctor:
    manifest: Manifest
    store: ModeStore

    def findings(self, mode: Mode) -> dict[str, list[Finding]]:
        sections: defaultdict[str, list[Finding]] = defaultdict(list)
        if not self.store.file.exists():
            sections["estado"].append(Finding(Level.WARN, f"sin {shown(self.store.file)}; se asume light"))
        for target in self.manifest.targets:
            sections[target.section].extend(target.check(mode))
        for generation in self.manifest.generations:
            sections["generadas"].extend(generation.check(self.manifest.palette))
        sections["consumidores"].extend(wiring.check() for wiring in self.manifest.wirings)
        context = ReloadContext(mode, running_processes())
        sections["recarga en vivo"].extend(chain.from_iterable(reload.check(context) for reload in self.manifest.reloads))
        if shutil.which("systemctl") is None:
            sections["systemd"].append(Finding(Level.WARN, "systemctl no disponible"))
        else:
            sections["systemd"].extend(chain.from_iterable(map(unit_findings, self.manifest.units)))
        return sections

    def run(self) -> bool:
        mode = self.store.read()
        print(f"doctor — mode: {mode}")
        sections = self.findings(mode)
        for title, findings in sections.items():
            if findings:
                print(f"\n[{title}]")
                for finding in findings:
                    print(f"  {finding.level:<5} {finding.message}")
        counts = Counter(finding.level for finding in chain.from_iterable(sections.values()))
        print(f"\nresultado: {counts[Level.OK]} ok, {counts[Level.FAIL]} fail, {counts[Level.WARN]} warn")
        return not counts[Level.FAIL]


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="eyes-theme", description="Cambia el tema eyes entre claro y oscuro según el manifiesto."
    )
    parser.add_argument("command", nargs="?", default="status", choices=COMMANDS)
    parser.add_argument("--dry-run", action="store_true", help="muestra lo que haría sin cambiar nada")
    parser.add_argument("--force", action="store_true", help="reaplica aunque el modo guardado coincida")
    args = parser.parse_args()
    sys.stdout.reconfigure(line_buffering=True)
    logging.basicConfig(format="eyes-theme: %(levelname)s: %(message)s")
    store = ModeStore(STATE_DIR)
    switcher = Switcher(Manifest.load(MANIFEST), store, dry_run=args.dry_run, force=args.force)
    match args.command:
        case "light" | "dark":
            switcher.switch(Mode(args.command))
        case "toggle":
            switcher.switch(store.read().opposite)
        case "auto":
            switcher.switch(Mode.for_hour(datetime.now(UTC).astimezone().hour))
        case "reapply":
            replace(switcher, force=True).switch(store.read())
        case "status":
            print(store.read())
        case "generate":
            switcher.generate()
        case "doctor":
            return 0 if Doctor(switcher.manifest, store).run() else 1
    return 0


sys.exit(main())
