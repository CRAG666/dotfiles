# vim: ft=swayconfig
#
# Default config for scroll
#
#
#

output * bg #1e1e2e solid_color

default_border none

# Launch the Quickshell greeter and exit when it finishes; the greeter user's
# home is /, so Quickshell keeps its cache and state in /var/lib/qs-greeter
exec "HOME=/var/lib/qs-greeter qs -p /etc/greetd/quickshell/greeter.qml; scrollmsg exit"

input type:touchpad {
    tap enabled
}
