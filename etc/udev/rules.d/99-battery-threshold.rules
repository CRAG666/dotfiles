# ThinkPad battery charge thresholds (thinkpad_acpi). powerprofilesctl doesn't handle this.
# ponytail: 1 udev rule instead of TLP/a service. Adjust the values here if usage changes.
ACTION=="add", SUBSYSTEM=="power_supply", KERNEL=="BAT0", ATTR{charge_control_end_threshold}="80", ATTR{charge_control_start_threshold}="75"
