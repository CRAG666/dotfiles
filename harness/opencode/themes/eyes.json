{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg0_l": "#f7dbb9", "bg0_d": "#192019",
    "bg1_l": "#f2d5b2", "bg1_d": "#1f271f",
    "bg2_l": "#edcfac", "bg2_d": "#252f25",
    "bg3_l": "#e6c7a3", "bg3_d": "#2c372c",
    "bg4_l": "#dab992", "bg4_d": "#3a463a",
    "bg5_l": "#b1936e", "bg5_d": "#667366",

    "fg0_l": "#231d18", "fg0_d": "#e4e0cc",
    "fg1_l": "#31251a", "fg1_d": "#d0d4be",
    "fg2_l": "#483523", "fg2_d": "#bbc7b0",

    "gray0_l": "#473b2d", "gray0_d": "#adbaa9",
    "gray1_l": "#3b3931", "gray1_d": "#b6b4ac",
    "gray2_l": "#392e23", "gray2_d": "#a2afa0",

    "green0_l": "#294f01", "green0_d": "#bfe6a1",
    "green1_l": "#003d1b", "green1_d": "#96d4a6",
    "green2_l": "#383f17", "green2_d": "#c3c799",

    "ash_l":    "#504531", "ash_d":    "#9fb9a1",
    "teal_l":   "#004d44", "teal_d":   "#95ded1",
    "blue0_l":  "#073c6e", "blue0_d":  "#a2cdf7",
    "blue1_l":  "#00314e", "blue1_d":  "#a8d7f0",
    "violet_l": "#3f206c", "violet_d": "#d5c9fc",
    "aqua_l":   "#003e4c", "aqua_d":   "#96d4e2",
    "orange0_l":"#5e2600", "orange0_d":"#f7bc95",
    "orange1_l":"#5f3700", "orange1_d":"#f4cb94",
    "red_l":    "#630005", "red_d":    "#ffbab1",
    "yellow_l": "#574a00", "yellow_d": "#f1de95",
    "pink_l":   "#661b53", "pink_d":   "#efb7db",

    "diffAddedBg_l":         "#e0f0d8", "diffAddedBg_d":         "#324a2e",
    "diffRemovedBg_l":       "#f4e0d4", "diffRemovedBg_d":       "#3f2e25",
    "diffAddedWordBg_l":     "#b8d8a8", "diffAddedWordBg_d":     "#4a6646",
    "diffRemovedWordBg_l":   "#e0b8a4", "diffRemovedWordBg_d":   "#714c41",
    "diffAddedDimmedBg_l":   "#cce4c0", "diffAddedDimmedBg_d":   "#28381f",
    "diffRemovedDimmedBg_l": "#e8d4c4", "diffRemovedDimmedBg_d": "#33231d"
  },
  "theme": {
    "primary":           { "light": "blue0_l",   "dark": "blue0_d"   },
    "secondary":         { "light": "blue1_l",   "dark": "blue1_d"   },
    "accent":            { "light": "aqua_l",    "dark": "aqua_d"    },
    "error":             { "light": "red_l",     "dark": "red_d"     },
    "warning":           { "light": "yellow_l",  "dark": "yellow_d"  },
    "success":           { "light": "green0_l",  "dark": "green0_d"  },
    "info":              { "light": "blue1_l",   "dark": "blue1_d"   },

    "text":              { "light": "fg1_l",     "dark": "fg1_d"     },
    "textMuted":         { "light": "fg2_l",     "dark": "fg2_d"     },

    "background":        { "light": "bg0_l",     "dark": "bg0_d"     },
    "backgroundPanel":   { "light": "bg1_l",     "dark": "bg1_d"     },
    "backgroundElement": { "light": "bg2_l",     "dark": "bg2_d"     },

    "border":            { "light": "bg4_l",     "dark": "bg4_d"     },
    "borderActive":      { "light": "blue0_l",   "dark": "blue0_d"   },
    "borderSubtle":      { "light": "bg3_l",     "dark": "bg3_d"     },

    "diffAdded":              { "light": "green0_l",          "dark": "green0_d"          },
    "diffRemoved":            { "light": "red_l",             "dark": "red_d"             },
    "diffContext":            { "light": "gray1_l",           "dark": "gray1_d"           },
    "diffHunkHeader":         { "light": "gray0_l",           "dark": "gray0_d"           },
    "diffHighlightAdded":     { "light": "green1_l",          "dark": "green1_d"          },
    "diffHighlightRemoved":   { "light": "red_l",             "dark": "red_d"             },
    "diffAddedBg":            { "light": "diffAddedBg_l",     "dark": "diffAddedBg_d"     },
    "diffRemovedBg":          { "light": "diffRemovedBg_l",   "dark": "diffRemovedBg_d"   },
    "diffContextBg":          { "light": "bg1_l",             "dark": "bg1_d"             },
    "diffLineNumber":         { "light": "gray2_l",           "dark": "gray2_d"           },
    "diffAddedLineNumberBg":  { "light": "diffAddedDimmedBg_l",   "dark": "diffAddedDimmedBg_d"   },
    "diffRemovedLineNumberBg":{ "light": "diffRemovedDimmedBg_l", "dark": "diffRemovedDimmedBg_d" },

    "markdownText":            { "light": "fg1_l",     "dark": "fg1_d"     },
    "markdownHeading":         { "light": "blue0_l",   "dark": "blue0_d"   },
    "markdownLink":            { "light": "blue1_l",   "dark": "blue1_d"   },
    "markdownLinkText":        { "light": "blue0_l",   "dark": "blue0_d"   },
    "markdownCode":            { "light": "green1_l",  "dark": "green1_d"  },
    "markdownBlockQuote":      { "light": "gray0_l",   "dark": "gray0_d"   },
    "markdownEmph":            { "light": "orange0_l", "dark": "orange0_d" },
    "markdownStrong":          { "light": "orange1_l", "dark": "orange1_d" },
    "markdownHorizontalRule":  { "light": "bg4_l",     "dark": "bg4_d"     },
    "markdownListItem":        { "light": "blue0_l",   "dark": "blue0_d"   },
    "markdownListEnumeration": { "light": "aqua_l",    "dark": "aqua_d"    },
    "markdownImage":           { "light": "blue1_l",   "dark": "blue1_d"   },
    "markdownImageText":       { "light": "aqua_l",    "dark": "aqua_d"    },
    "markdownCodeBlock":       { "light": "fg1_l",     "dark": "fg1_d"     },

    "syntaxComment":     { "light": "ash_l",     "dark": "ash_d"     },
    "syntaxKeyword":     { "light": "violet_l",  "dark": "violet_d"  },
    "syntaxFunction":    { "light": "blue1_l",   "dark": "blue1_d"   },
    "syntaxVariable":    { "light": "fg0_l",     "dark": "fg0_d"     },
    "syntaxString":      { "light": "green1_l",  "dark": "green1_d"  },
    "syntaxNumber":      { "light": "pink_l",    "dark": "pink_d"    },
    "syntaxType":        { "light": "aqua_l",    "dark": "aqua_d"    },
    "syntaxOperator":    { "light": "teal_l",    "dark": "teal_d"    },
    "syntaxPunctuation": { "light": "gray1_l",   "dark": "gray1_d"   }
  }
}
