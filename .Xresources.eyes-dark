! eyes (light) — sage-green theme for X11 apps (xterm, urxvt, etc.)
*background:       #192019
*foreground:       #e4e0cc

! black
*color0:           #e4e0cc
*color8:           #adbaa9

! red
*color1:           #ffbab1
*color9:           #ffbab1

! green
*color2:           #bfe6a1
*color10:          #c3c799

! yellow
*color3:           #f1de95
*color11:          #f4cb94

! blue
*color4:           #a2cdf7
*color12:          #a8d7f0

! magenta
*color5:           #efb7db
*color13:          #d5c9fc

! cyan
*color6:           #95ded1
*color14:          #96d4e2

! white
*color7:           #3a463a
*color15:          #1f271f
