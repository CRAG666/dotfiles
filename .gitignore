__pycache__/
*.log
*.AppImage
/config/hypr/scripts/marks.json
config/yazi/plugins
config/nushell/plugin*
config/nushell/history.*

# awww / quickshell — per-machine wallpaper state
config/awww/wall.blur
config/awww/wall.ctl
config/awww/wall.set
config/quickshell/theme.state

# spotlight — sqlite scratch files next to the git-crypt'd databases
local/share/spotlight/*-journal
local/share/spotlight/*-wal
local/share/spotlight/*-shm

# termusic — regenerable db/cache
config/termusic/*.db
config/termusic/*.db-wal
config/termusic/*.db-shm
# termusic — bundled themes it writes on its own; only the eyes pair is ours
/config/termusic/themes/*
!/config/termusic/themes/eyes.yml
!/config/termusic/themes/eyes-dark.yml

# w3m — browser session state (never commit)
.w3m/cookie
.w3m/history
.w3m/w3mtmp*

# aerc — accounts with private metadata
config/aerc/accounts.conf

# oama — encrypted tokens (default location is ~/.local/share/oama)
config/oama/*.auth

# hunk / termfilechooser — runtime state rewritten by the apps
config/hunk/state.json
config/xdg-desktop-portal-termfilechooser/.last_selected

# herdr — runtime state rewritten by the app
config/herdr/.plugins.lock
config/herdr/release-notes.json
config/herdr/session-snapshots/
config/herdr/session.json
config/herdr/sessions/

# mpv — upstream assets installed by `just uosc` and `just mpv-assets`
/config/mpv/scripts/uosc/
/config/mpv/fonts/uosc_*
/config/mpv/scripts/thumbfast.lua
/config/mpv/shaders/*
!/config/mpv/shaders/noise_static_*.hook


# ── eyes-theme: active-variant pointers ──────────────────────────────────
# Gitignored symlinks repointed by local/bin/eyes-theme on each light/dark
# switch. The two committed variants live beside them; only the pointer
# moves, so toggling the theme never dirties the repo.
/home/.tmux.colors.conf
/home/.Xresources
/config/hunk/config.toml
/config/herdr/config.toml
/config/eza/theme.yml
/config/zsh-patina/theme.toml
/config/hypr/colors/theme.conf
/config/btop/themes/eyes-active.theme
/config/atuin/themes/eyes-active.toml
/config/termusic/themes/eyes-active.yml
/config/zathura/eyes-activerc
/config/foot/colors.ini
/config/shell/colors.env
/config/scroll/colors.conf
/config/nushell/theme.nu
/config/tridactyl/themes/theme.css
/config/starship.toml
/config/yazi/flavors/eyes.yazi
/config/yazi/colors.lua
/config/termusic/tui.toml
/config/mpv/colors.conf
**/.a5c
**/.claude
**/.agents
**/.crush
/config/nvim/nvim-pack-lock.json
/config/nushell/mise.nu

# sunshine — TLS key, web UI credentials, paired clients and logs written at runtime
/config/sunshine/credentials/
/config/sunshine/sunshine_state.json
/config/sunshine/sunshine.log*
/config/sunshine/covers/
