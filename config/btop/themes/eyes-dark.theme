#
# btop "eyes-dark" theme — dark forest variant
# Matches config/nvim/colors/eyes.lua (dark mode)
#

theme[main_bg]="#192019"
theme[main_fg]="#e4e0cc"
theme[title]="#e4e0cc"
theme[hi_fg]="#ffbab1"
theme[selected_bg]="#3a463a"
theme[selected_fg]="#e4e0cc"
theme[inactive_fg]="#b6b4ac"
theme[graph_text]="#e4e0cc"
theme[meter_bg]="#2c372c"
theme[proc_misc]="#d5c9fc"

theme[cpu_box]="#d5c9fc"      # violet
theme[mem_box]="#bfe6a1"      # green
theme[net_box]="#ffbab1"      # red
theme[proc_box]="#a2cdf7"     # blue

theme[div_line]="#667366"

theme[temp_start]="#bfe6a1"
theme[temp_mid]="#f1de95"
theme[temp_end]="#ffbab1"

theme[cpu_start]="#95ded1"
theme[cpu_mid]="#a2cdf7"
theme[cpu_end]="#d5c9fc"

theme[free_start]="#d5c9fc"
theme[free_mid]="#a2cdf7"
theme[free_end]="#a8d7f0"

theme[cached_start]="#96d4e2"
theme[cached_mid]="#95ded1"
theme[cached_end]="#a2cdf7"

theme[available_start]="#f4cb94"
theme[available_mid]="#ffbab1"
theme[available_end]="#ffbab1"

theme[used_start]="#bfe6a1"
theme[used_mid]="#c3c799"
theme[used_end]="#95ded1"

theme[download_start]="#f4cb94"
theme[download_mid]="#ffbab1"
theme[download_end]="#ffbab1"

theme[upload_start]="#bfe6a1"
theme[upload_mid]="#c3c799"
theme[upload_end]="#95ded1"

theme[process_start]="#a2cdf7"
theme[process_mid]="#a8d7f0"
theme[process_end]="#d5c9fc"
