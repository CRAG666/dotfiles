#
# btop "eyes" theme — sage-green light palette
# Designed to match config/nvim/colors/eyes.lua (light mode)
#

# Main background (sage green)
theme[main_bg]="#f7dbb9"

# Main text
theme[main_fg]="#231d18"

# Title color for boxes
theme[title]="#231d18"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#630005"

# Background color of selected item in processes box
theme[selected_bg]="#b1936e"

# Foreground color of selected item in processes box
theme[selected_fg]="#231d18"

# Color of inactive/disabled text
theme[inactive_fg]="#473b2d"

# Color of text appearing on top of graphs
theme[graph_text]="#231d18"

# Background color of the percentage meters
theme[meter_bg]="#dab992"

# Misc colors for processes box
theme[proc_misc]="#3f206c"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#3f206c"      # violet
theme[mem_box]="#294f01"      # green
theme[net_box]="#630005"      # red
theme[proc_box]="#073c6e"     # blue

# Box divider line
theme[div_line]="#473b2d"

# Temperature graph (cool -> warm)
theme[temp_start]="#294f01"
theme[temp_mid]="#574a00"
theme[temp_end]="#630005"

# CPU graph (teal -> violet)
theme[cpu_start]="#004d44"
theme[cpu_mid]="#073c6e"
theme[cpu_end]="#3f206c"

# Mem/Disk free meter
theme[free_start]="#3f206c"
theme[free_mid]="#073c6e"
theme[free_end]="#00314e"

# Mem/Disk cached meter
theme[cached_start]="#003e4c"
theme[cached_mid]="#004d44"
theme[cached_end]="#073c6e"

# Mem/Disk available meter (orange -> red)
theme[available_start]="#5f3700"
theme[available_mid]="#630005"
theme[available_end]="#630005"

# Mem/Disk used meter (green -> teal)
theme[used_start]="#294f01"
theme[used_mid]="#383f17"
theme[used_end]="#004d44"

# Download graph (orange -> red)
theme[download_start]="#5f3700"
theme[download_mid]="#630005"
theme[download_end]="#630005"

# Upload graph (green -> teal)
theme[upload_start]="#294f01"
theme[upload_mid]="#383f17"
theme[upload_end]="#004d44"

# Process box gradient (blue -> violet)
theme[process_start]="#073c6e"
theme[process_mid]="#00314e"
theme[process_end]="#3f206c"
