{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": "ask",
    "edit": "ask",
    "webfetch": "ask"
  },
  "model": "ollama/devstral-small-2:latest",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (cluster vía túnel)",
      "options": {
        "baseURL": "http://localhost:11652/v1"
      },
      "models": {
        "qwen3.6:35b-a3b": { "name": "Qwen3.6" },
        "science-assistant:latest": { "name": "Science Assistant" },
        "gpt-oss:120b": { "name": "GPT OSS" },
        "devstral-small-2:latest": { "name": "DevStral Small 2" }
      }
    }
  }
}
