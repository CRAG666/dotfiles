[Unit]
Description=Apply eyes theme matching current local time
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/eyes-theme auto
# The switch restarts daemons (zsh-patina) that must outlive the oneshot
KillMode=process

[Install]
WantedBy=default.target
