let theme = {
  # FG colors are kept aligned with config/nvim/colors/eyes.lua (dark block).
  # NOTE: maroon and pink must be FG values, not c_winterRed/c_winterYellow
  # (those are BG tints — assigning them to shape_flag/shape_custom would make
  # flags and custom commands render almost invisible on dark bg).
  rosewater: "#96d4a6"   # c_green1
  flamingo: "#a8d7f0"    # c_blue1
  pink: "#efb7db"        # c_pink (FG pink)
  mauve: "#d5c9fc"       # c_violet
  red: "#ffbab1"         # c_red
  maroon: "#f4cb94"      # c_orange1 (coral-ish FG)
  peach: "#f7bc95"       # c_orange0
  yellow: "#f1de95"      # c_yellow
  green: "#bfe6a1"       # c_green0
  teal: "#95ded1"        # c_teal
  sky: "#a2cdf7"         # c_blue0
  sapphire: "#96d4e2"    # c_aqua
  blue: "#a2cdf7"        # c_blue0
  lavender: "#efb7db"    # c_pink (alias of pink)
  text: "#e4e0cc"        # c_fg0
  overlay2: "#b6b4ac"    # c_gray1
  surface2: "#a2afa0"    # c_gray2
  base: "#192019"        # c_bg0
  mantle: "#2c372c"      # c_bg3
  crust: "#3a463a"       # c_bg4
}
