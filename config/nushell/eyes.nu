let theme = {
  # FG colors are kept aligned with config/nvim/colors/eyes.lua (dark block).
  # NOTE: maroon and pink must be FG values, not c_winterRed/c_winterYellow
  # (those are BG tints — assigning them to shape_flag/shape_custom would make
  # flags and custom commands render almost invisible on dark bg).
  rosewater: "#003d1b"   # c_green1
  flamingo: "#00314e"    # c_blue1
  pink: "#661b53"        # c_pink (FG pink)
  mauve: "#3f206c"       # c_violet
  red: "#630005"         # c_red
  maroon: "#5f3700"      # c_orange1 (coral-ish FG)
  peach: "#5e2600"       # c_orange0
  yellow: "#574a00"      # c_yellow
  green: "#294f01"       # c_green0
  teal: "#004d44"        # c_teal
  sky: "#073c6e"         # c_blue0
  sapphire: "#003e4c"    # c_aqua
  blue: "#073c6e"        # c_blue0
  lavender: "#661b53"    # c_pink (alias of pink)
  text: "#231d18"        # c_fg0
  overlay2: "#3b3931"    # c_gray1
  surface2: "#392e23"    # c_gray2
  base: "#f7dbb9"        # c_bg0
  mantle: "#e6c7a3"      # c_bg3
  crust: "#dab992"       # c_bg4
}
