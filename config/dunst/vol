#!/bin/bash

# You can call this script like this:
# $./volume.sh up
# $./volume.sh down
# $./volume.sh mute
# $./volume.sh mic
# $./volume.sh mic-led

# mic-mute LED, writable once etc/udev/rules.d/99-micmute-led.rules is installed
mic_led() {
	led=/sys/class/leds/platform::micmute/brightness
	[ -w "$led" ] && echo "$1" >"$led"
	return 0
}

case $1 in
up)
	wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ >/dev/null
	;;
down)
	wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%- >/dev/null
	;;
mute)
	# Toggle mute
	wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
	exit 0
	;;
mic)
	wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
	if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
		mic_led 1
		notify-send -i microphone-sensitivity-muted -h string:x-dunst-stack-tag:mic "Microphone off"
	else
		mic_led 0
		notify-send -i microphone-sensitivity-high -h string:x-dunst-stack-tag:mic "Microphone on"
	fi
	exit 0
	;;
mic-led)
	# at login: WirePlumber restores the mute, the LED starts off
	if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then mic_led 1; else mic_led 0; fi
	exit 0
	;;
*)
	exit 0
	;;
esac

# The sound runs in the background: pw-play blocks for the wav's length (~380 ms)
# and delayed the OSD; the notification must appear with the keypress.
pw-play ~/.config/dunst/vol.wav >/dev/null 2>&1 &

volume_integer=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2 * 100 + 0.5)}')

if [ "$volume_integer" -eq 0 ]; then
	icon="audio-volume-muted"
elif [ "$volume_integer" -le 33 ]; then
	icon="audio-volume-low"
elif [ "$volume_integer" -le 66 ]; then
	icon="audio-volume-medium"
else
	icon="audio-volume-high"
fi

notify-send -i "$icon" \
	-h int:value:$volume_integer \
	-h string:x-dunst-stack-tag:volume \
	"Volume"
