# Shared themed vars — single source of truth for the eyes palette (zsh + nushell).
#
# Read by:
#   - zsh     (.zshrc):   set -a; source "$DOT_DIR/config/shell/colors.env"; set +a
#   - login   (.profile): set -a; . "$DOT_DIR/config/shell/colors.env"; set +a
#   - nushell (env.nu):   parsed and loaded via load-env (loader block at end of env.nu)
#
# Same parser rules as vars.env: one KEY="value" per line, value always
# double-quoted, no line breaks inside a value, '#' only at column 0 for comments.
#
# eyes-theme rewrites this file on every light/dark toggle:
#   - the #RRGGBB / SGR (38;2;… 48;2;…) colors via its HEX_SWAP_FILES list;
#   - BAT_THEME via a NAME_SWAP entry (eyes <-> eyes-dark).
# Keep every color a literal drawn from the eyes palette (config/nvim/colors/eyes.lua).

# --- bat ---
BAT_THEME="eyes"

# --- LS_COLORS — truecolor SGR codes (GNU ls, tree, fd, eza fallback, nushell) ---
LS_COLORS="di=1;38;2;7;60;110:ln=38;2;0;77;68:or=38;2;99;0;5;1:ex=1;38;2;41;79;1:fi=38;2;35;29;24:pi=38;2;94;38;0:so=38;2;102;27;83:bd=38;2;95;55;0:cd=38;2;87;74;0:do=38;2;63;32;108:su=1;38;2;138;40;32:sg=1;38;2;138;40;32:tw=38;2;35;29;24;48;2;108;144;96:ow=38;2;7;60;110;48;2;242;213;178:st=38;2;247;219;185;48;2;7;60;110:*.tar=38;2;102;27;83:*.tgz=38;2;102;27;83:*.gz=38;2;102;27;83:*.zip=38;2;102;27;83:*.7z=38;2;102;27;83:*.xz=38;2;102;27;83:*.zst=38;2;102;27;83:*.bz2=38;2;102;27;83:*.rar=38;2;102;27;83:*.jpg=38;2;94;38;0:*.jpeg=38;2;94;38;0:*.png=38;2;94;38;0:*.gif=38;2;94;38;0:*.bmp=38;2;94;38;0:*.webp=38;2;94;38;0:*.svg=38;2;94;38;0:*.mp4=38;2;99;0;5:*.mkv=38;2;99;0;5:*.webm=38;2;99;0;5:*.mov=38;2;99;0;5:*.avi=38;2;99;0;5:*.mp3=38;2;41;79;1:*.flac=38;2;41;79;1:*.wav=38;2;41;79;1:*.ogg=38;2;41;79;1:*.opus=38;2;41;79;1:*.pdf=38;2;0;77;68:*.epub=38;2;0;77;68:*.djvu=38;2;0;77;68:*.md=38;2;0;62;76:*.txt=38;2;35;29;24"

# --- FZF ---
FZF_DEFAULT_OPTS=" --prompt='ﰉ ' --pointer='ﰊ' --height 40% --reverse --bind='?:toggle-preview' --color=bg+:#dab992,bg:#f7dbb9,spinner:#661b53,hl:#630005 --color=fg:#073c6e,header:#630005,info:#3f206c,pointer:#661b53 --color=marker:#661b53,fg+:#231d18,prompt:#3f206c,hl+:#630005"

