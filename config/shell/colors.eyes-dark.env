# Shared themed vars — single source of truth for the eyes palette (zsh + nushell).
#
# Read by:
#   - zsh     (.zshrc):   set -a; source "$DOT_DIR/config/shell/colors.env"; set +a
#   - login   (.profile): set -a; . "$DOT_DIR/config/shell/colors.env"; set +a
#   - nushell (env.nu):   parsed and loaded via load-env (loader block at end of env.nu)
#
# Same parser rules as vars.env: one KEY="value" per line, value always
# double-quoted, no line breaks inside a value, '#' only at column 0 for comments.
#
# eyes-theme rewrites this file on every light/dark toggle:
#   - the #RRGGBB / SGR (38;2;… 48;2;…) colors via its HEX_SWAP_FILES list;
#   - BAT_THEME via a NAME_SWAP entry (eyes <-> eyes-dark).
# Keep every color a literal drawn from the eyes palette (config/nvim/colors/eyes.lua).

# --- bat ---
BAT_THEME="eyes-dark"

# --- LS_COLORS — truecolor SGR codes (GNU ls, tree, fd, eza fallback, nushell) ---
LS_COLORS="di=1;38;2;162;205;247:ln=38;2;149;222;209:or=38;2;255;186;177;1:ex=1;38;2;191;230;161:fi=38;2;228;224;204:pi=38;2;247;188;149:so=38;2;239;183;219:bd=38;2;244;203;148:cd=38;2;241;222;149:do=38;2;213;201;252:su=1;38;2;138;40;32:sg=1;38;2;138;40;32:tw=38;2;228;224;204;48;2;108;144;96:ow=38;2;162;205;247;48;2;31;39;31:st=38;2;25;32;25;48;2;162;205;247:*.tar=38;2;239;183;219:*.tgz=38;2;239;183;219:*.gz=38;2;239;183;219:*.zip=38;2;239;183;219:*.7z=38;2;239;183;219:*.xz=38;2;239;183;219:*.zst=38;2;239;183;219:*.bz2=38;2;239;183;219:*.rar=38;2;239;183;219:*.jpg=38;2;247;188;149:*.jpeg=38;2;247;188;149:*.png=38;2;247;188;149:*.gif=38;2;247;188;149:*.bmp=38;2;247;188;149:*.webp=38;2;247;188;149:*.svg=38;2;247;188;149:*.mp4=38;2;255;186;177:*.mkv=38;2;255;186;177:*.webm=38;2;255;186;177:*.mov=38;2;255;186;177:*.avi=38;2;255;186;177:*.mp3=38;2;191;230;161:*.flac=38;2;191;230;161:*.wav=38;2;191;230;161:*.ogg=38;2;191;230;161:*.opus=38;2;191;230;161:*.pdf=38;2;149;222;209:*.epub=38;2;149;222;209:*.djvu=38;2;149;222;209:*.md=38;2;150;212;226:*.txt=38;2;228;224;204"

# --- FZF ---
FZF_DEFAULT_OPTS=" --prompt='ﰉ ' --pointer='ﰊ' --height 40% --reverse --bind='?:toggle-preview' --color=bg+:#3a463a,bg:#192019,spinner:#efb7db,hl:#ffbab1 --color=fg:#a2cdf7,header:#ffbab1,info:#d5c9fc,pointer:#efb7db --color=marker:#efb7db,fg+:#e4e0cc,prompt:#d5c9fc,hl+:#ffbab1"

