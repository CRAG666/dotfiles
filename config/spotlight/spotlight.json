{
  "aliases": {
    "files": "fi", "contents": "fc", "clipboard": "cb", "windows": "win", "emoji": "ej", "passwords": "pw",
    "snippets": "sn", "commands": "cmd", "bookmarks": "bm", "notes": "nt", "quicklinks": "ql", "processes": "ps",
    "history": "bh", "tabs": "bt", "timers": "tm", "colors": "co", "notifications": "nf", "ai": "ac",
    "marks": "mk", "herdr": "hr", "agenda": "ag", "wallpapers": "wp", "tools": "tl", "help": "?"
  },
  "chips": ["apps", "files", "clipboard", "windows", "passwords", "snippets", "commands"],
  "webSearch": "https://www.google.com/search?q={query}",
  "fallbacks": ["pi", "web"],
  "ai": { "model": "openai/gpt-oss-20b", "thinking": "off" },
  "pomodoro": { "focus": 25, "break": 5, "rounds": 4 },
  "terminal": ["ghostty", "-e"],
  "floatingTerminal": ["ghostty", "--class=ghostty.dialog", "-e"],
  "browser": ["zen-browser"],
  "tools": [
    { "title": "Email", "command": ["aerc"] },
    { "title": "Bluetooth", "icon": "bluetooth", "command": ["bluetui"], "floating": true },
    { "title": "Wi-Fi", "icon": "network-wireless", "command": ["impala"], "floating": true },
    { "title": "Files", "icon": "system-file-manager", "command": ["yazi"], "floating": true },
    { "title": "Calendar", "icon": "office-calendar", "command": ["cal", "-3", "-m"], "floating": true, "hold": true },
    { "title": "Music", "command": ["termusic"] },
    { "title": "Volume Mixer", "icon": "audio-volume-high", "command": ["wiremix"], "floating": true }
  ],
  "snippets": [
    { "name": "Today", "keyword": "today", "text": "{date}" },
    { "name": "Timestamp", "keyword": "ts", "text": "{date} {time}" },
    { "name": "Markdown link", "keyword": "mdl", "text": "[{cursor}]({clipboard})" }
  ],
  "quicklinks": [
    { "name": "YouTube", "keyword": "yt", "home": "https://www.youtube.com/", "url": "https://www.youtube.com/results?search_query={query}" },
    { "name": "GitHub", "keyword": "gh", "home": "https://github.com/", "url": "https://github.com/search?q={query}" },
    { "name": "Arch Wiki", "keyword": "aw", "home": "https://wiki.archlinux.org/", "url": "https://wiki.archlinux.org/index.php?search={query}" },
    { "name": "Claude", "keyword": "cl", "home": "https://claude.ai/new", "url": "https://claude.ai/new?q={query}" },
    { "name": "WhatsApp", "keyword": "wa", "url": "https://web.whatsapp.com/" },
    { "name": "Semantic Scholar", "keyword": "ss", "home": "https://www.semanticscholar.org/", "url": "https://www.semanticscholar.org/search?q={query}", "open": ["zen-browser", "-P", "Inaoe"] },
    { "name": "DBLP", "keyword": "dblp", "home": "https://dblp.org/", "url": "https://dblp.org/search?q={query}", "open": ["zen-browser", "-P", "Inaoe"] },
    { "name": "IEEE Xplore", "keyword": "ieee", "home": "https://ieeexplore.ieee.org/Xplore/home.jsp", "url": "https://ieeexplore.ieee.org/search/searchresult.jsp?queryText={query}", "open": ["zen-browser", "-P", "Inaoe"] },
    {
