    { "name": "Traducir al español", "output": "paste", "prompt": "Traduce el texto al español. Devuelve solo la traducción." },
    { "name": "Summarize", "output": "show", "prompt": "Summarize the text in a few bullet points, in the text's own language." },
    { "name": "Explain Code", "output": "show", "prompt": "Explain what this code does, step by step and concisely." }
