font-family = "DankMono Nerd Font Mono"
font-size = 15

theme = light:eyes-light,dark:eyes-dark
window-theme = ghostty

command = /usr/bin/nu
shell-integration-features = no-cursor,sudo,ssh-env,ssh-terminfo
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 10s

window-decoration = none
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
gtk-tabs-location = bottom
unfocused-split-opacity = 1

cursor-style = underline
copy-on-select = clipboard
app-notifications = no-clipboard-copy
mouse-hide-while-typing = true
quit-after-last-window-closed = false

keybind = ctrl+enter=unbind
keybind = ctrl+shift+enter=unbind
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = ctrl+shift+o=unbind
keybind = ctrl+shift+e=unbind
keybind = ctrl+shift+t=unbind
