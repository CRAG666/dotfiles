#!/usr/bin/env bash
# cliphist modi for rofi with image thumbnails.
#
# The thumbnail cache is PERSISTENT per session: it used to rm -rf and
# re-decode the whole history on every open (~350 ms with 80
# images, synchronous before drawing the menu). Now it only decodes what
# is missing (in parallel) and orphans are pruned in the background.

tmp_dir="${XDG_RUNTIME_DIR:-/tmp}/cliphist-thumbs"

if [[ -n "$1" ]]; then
	cliphist decode <<<"$1" | wl-copy
	exit
fi

mkdir -p "$tmp_dir"

list=$(cliphist list)

# decode only the missing thumbnails, in parallel
declare -A want=()
while IFS= read -r line; do
	[[ $line =~ ^([0-9]+)[[:space:]](\[\[[[:space:]])?binary.*(jpg|jpeg|png|bmp) ]] || continue
	f="${BASH_REMATCH[1]}.${BASH_REMATCH[3]}"
	want[$f]=1
	[[ -s "$tmp_dir/$f" ]] && continue
	cliphist decode <<<"${BASH_REMATCH[1]}"$'\t' > "$tmp_dir/$f" &
done <<< "$list"
wait

# emit the list (gawk: a single pass, no spawns)
gawk -v dir="$tmp_dir" '
/^[0-9]+\s<meta http-equiv=/ { next }
match($0, /^([0-9]+)\s(\[\[\s)?binary.*(jpg|jpeg|png|bmp)/, grp) {
    print $0 "\0icon\x1f" dir "/" grp[1] "." grp[3]
    next
}
1
' <<< "$list"

# prune thumbnails of entries already expired from the history (off the
# critical path: rofi already has the list)
{
	for f in "$tmp_dir"/*; do
		[[ -e $f ]] || break
		[[ ${want[${f##*/}]+x} ]] || rm -f "$f"
	done
} &
disown
