set statusbar-h-padding 14
set statusbar-v-padding 8
set page-v-padding 12
set page-h-padding 12
set guioptions none
map <C-;> toggle_statusbar
set synctex true
set synctex-editor-command "nvim --server $NVIM --remote-send ':VimtexInverseSearch %{line} %{input}<CR>'"
set selection-clipboard "clipboard"
set window-title-home-tilde "true"
set window-title-basename "true"
set window-title-page true
set statusbar-basename "true"
set statusbar-home-tilde true
set statusbar-page-percent true
set adjust-open width
set recolor-keephue "true"
set recolor-reverse-video true
set render-loading false
set scroll-page-aware true
set font "SFProText Nerd Font Propo Medium 13"
set selection-notification false
set zoom-center true
include ./eyes-activerc
