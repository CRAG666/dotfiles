#!/bin/bash

MOUNT_OPTIONS=(
	--daemon
	--allow-non-empty
	--vfs-cache-mode full
	--vfs-cache-max-size 8G
	--vfs-cache-max-age 168h
	--buffer-size 32M
	--vfs-read-ahead 256M
	--vfs-read-chunk-size 128M
	--vfs-read-chunk-size-limit off
	--dir-cache-time 1000h
	--poll-interval 15s
	--vfs-refresh
	--transfers 8
	--checkers 16
	--drive-chunk-size 64M
	--onedrive-chunk-size 100M
	--onedrive-delta
)

MOUNT_POINTS=(
	"Drive:/ $HOME/Public/Drive"
	"InaoeDrive:/ $HOME/Public/InaoeDrive"
	"InaoeOneDrive:/ $HOME/Public/InaoeOneDrive"
)

MAX_RETRIES=3
INTERVAL=30

attempt=0
while ! ping -c 1 8.8.8.8 &>/dev/null; do
	attempt=$((attempt + 1))
	echo "No hay conexión a internet. Intento $attempt de $MAX_RETRIES..."
	if [ "$attempt" -ge "$MAX_RETRIES" ]; then
		echo "Error: No se pudo establecer la conexión a internet después de $MAX_RETRIES intentos."
		exit 1
	fi
	echo "Reintentando en $INTERVAL segundos..."
	sleep $INTERVAL
done

echo "Conexión a internet establecida. Montando unidades..."

for MOUNT in "${MOUNT_POINTS[@]}"; do
	read -r SOURCE TARGET <<<"$MOUNT"
	rclone mount "$SOURCE" "$TARGET" "${MOUNT_OPTIONS[@]}" &
done

wait
echo "Todos los puntos de montaje están listos."
